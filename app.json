{
  "expo": {
    "name": "apptodolist",
    "slug": "apptodolist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/images/icon.png",
